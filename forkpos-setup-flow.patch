new file mode 100644
index 0000000..9dedc7d
--- /dev/null
+++ b/tests/Feature/ProfileCatalogSyncTest.php
@@ -0,0 +1,145 @@
+<?php
+
+namespace Tests\Feature;
+
+use App\Models\Item;
+use App\Models\ItemPrice;
+use App\Models\PosProfile;
+use App\Models\Setting;
+use App\Models\StockBalance;
+use App\Models\SyncState;
+use App\Services\ProfileCatalogSync;
+use App\Support\PosProfileConfig;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+use Illuminate\Http\Client\Request;
+use Illuminate\Support\Facades\Http;
+use Tests\TestCase;
+
+class ProfileCatalogSyncTest extends TestCase
+{
+    use RefreshDatabase;
+
+    protected function setUp(): void
+    {
+        parent::setUp();
+        Setting::current()->forceFill([
+            'erpnext_url' => 'https://erp.example.test',
+            'erpnext_api_key' => 'k',
+            'erpnext_api_secret' => 's',
+        ])->save();
+        Setting::flushCache();
+    }
+
+    protected function profile(): PosProfile
+    {
+        return PosProfile::create([
+            'name' => 'Test Van POS',
+            'erpnext_id' => 'Test Van POS',
+            'currency' => 'MMK',
+            'selling_price_list' => 'Retail',
+            'synced_at' => now(),
+            'erpnext_data' => [
+                'name' => 'Test Van POS',
+                'warehouse' => 'Stores - M',
+                'item_groups' => [['item_group' => 'Drinks']],
+                'customer_groups' => [['customer_group' => 'Retail']],
+            ],
+        ]);
+    }
+
+    protected function fakeCatalog(int $binStatus = 200): void
+    {
+        $modified = '2026-11-16 10:00:00.000000';
+        Http::fake([
+            'erp.example.test/api/method/ping' => Http::response(['message' => 'pong'], 200),
+            'erp.example.test/api/resource/Warehouse*' => Http::response(['data' => [['name' => 'Stores - M', 'is_group' => 0, 'company' => 'ACME']]], 200),
+            'erp.example.test/api/resource/Item%20Price*' => Http::response(['data' => [[
+                'name' => 'IP1', 'item_code' => 'ITEM-1', 'price_list' => 'Retail', 'price_list_rate' => 5, 'currency' => 'MMK', 'modified' => $modified,
+            ]]], 200),
+            'erp.example.test/api/resource/Item*' => Http::response(['data' => [[
+                'name' => 'ITEM-1', 'item_code' => 'ITEM-1', 'item_name' => 'Tea', 'item_group' => 'Drinks',
+                'stock_uom' => 'Nos', 'sales_uom' => 'Nos', 'is_stock_item' => 1, 'standard_rate' => 4, 'disabled' => 0, 'modified' => $modified,
+            ]]], 200),
+            'erp.example.test/api/resource/Bin*' => $binStatus === 200
+                ? Http::response(['data' => [['item_code' => 'ITEM-1', 'warehouse' => 'Stores - M', 'actual_qty' => 12]]], 200)
+                : Http::response([], $binStatus),
+            'erp.example.test/api/resource/Customer*' => Http::response(['data' => [[
+                'name' => 'CUST-1', 'customer_name' => 'Ko Ko', 'customer_group' => 'Retail', 'territory' => 'All Territories', 'disabled' => 0, 'modified' => $modified,
+            ]]], 200),
+        ]);
+    }
+
+    public function test_pulls_only_what_the_profile_scopes_and_marks_it_ready(): void
+    {
+        $this->fakeCatalog();
+        $profile = $this->profile();
+        $sync = app(ProfileCatalogSync::class);
+
+        $this->assertFalse($sync->isReady($profile));
+
+        $outcome = $sync->run($profile);
+
+        $this->assertSame('done', $outcome['item']);
+        $this->assertSame('done', $outcome['stock']);
+        $this->assertTrue($sync->isReady($profile->fresh()));
+
+        $item = Item::where('erpnext_id', 'ITEM-1')->firstOrFail();
+        $this->assertSame('MMK', ItemPrice::where('item_id', $item->id)->value('currency'));
+        $this->assertSame('Retail', ItemPrice::where('item_id', $item->id)->value('price_list'));
+        $this->assertEquals(12, StockBalance::where('item_id', $item->id)->value('qty'));
+        $this->assertNotNull($profile->fresh()->warehouse_id, 'warehouse step links the profile');
+
+        // The requests were scoped to the profile, not "everything".
+        Http::assertSent(fn (Request $r) => str_contains($r->url(), 'resource/Item?') && str_contains(urldecode($r->url()), '["item_group","in",["Drinks"]]'));
+        Http::assertSent(fn (Request $r) => str_contains($r->url(), 'resource/Item%20Price') && str_contains(urldecode($r->url()), '["price_list","=","Retail"]'));
+        Http::assertSent(fn (Request $r) => str_contains($r->url(), 'resource/Customer') && str_contains(urldecode($r->url()), '["customer_group","in",["Retail"]]'));
+    }
+
+    public function test_second_run_fetches_only_changes_since_the_stored_cursor(): void
+    {
+        $this->fakeCatalog();
+        $profile = $this->profile();
+        $sync = app(ProfileCatalogSync::class);
+
+        $sync->run($profile);
+        $this->assertSame('2026-11-16 10:00:00.000000', SyncState::where('pos_profile_id', $profile->id)->where('entity', 'item')->value('cursor'));
+
+        $sync->run($profile->fresh());
+
+        Http::assertSent(fn (Request $r) => str_contains($r->url(), 'resource/Item?') && str_contains(urldecode($r->url()), '["modified",">","2026-11-16 10:00:00.000000"]'));
+    }
+
+    public function test_a_failing_step_is_recorded_and_blocks_readiness(): void
+    {
+        $this->fakeCatalog(binStatus: 500);
+        $profile = $this->profile();
+        $sync = app(ProfileCatalogSync::class);
+
+        $outcome = $sync->run($profile);
+
+        $this->assertSame('failed', $outcome['stock']);
+        $this->assertSame('done', $outcome['item']);
+        $this->assertFalse($sync->isReady($profile->fresh()));
+        $this->assertTrue($sync->progress($profile->fresh())['failed']);
+    }
+
+    public function test_local_only_profiles_are_always_ready(): void
+    {
+        $local = PosProfile::create(['name' => 'Local']);
+
+        $this->assertTrue(app(ProfileCatalogSync::class)->isReady($local));
+    }
+
+    public function test_profile_config_maps_erpnext_flags_and_keeps_local_defaults_separate(): void
+    {
+        $synced = PosProfileConfig::synced([
+            'name' => 'P', 'currency' => 'MMK', 'allow_user_to_edit_rate' => 1, 'customer' => 'Walk-in',
+        ]);
+
+        $this->assertTrue($synced['allow_rate_change']);
+        $this->assertFalse($synced['allow_discount_change']);
+        $this->assertFalse($synced['ask_for_customer']);
+        $this->assertArrayNotHasKey('require_shift', $synced, 'local-only fields are not overwritten by ERPNext');
+        $this->assertTrue(PosProfileConfig::localDefaults()['require_shift']);
+    }
+}
diff --git a/tests/Feature/SetupFlowTest.php b/tests/Feature/SetupFlowTest.php
new file mode 100644
index 0000000..0c70b86
--- /dev/null
+++ b/tests/Feature/SetupFlowTest.php
@@ -0,0 +1,178 @@
+<?php
+
+namespace Tests\Feature;
+
+use App\Models\Item;
+use App\Models\PosProfile;
+use App\Models\Setting;
+use App\Models\User;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+use Illuminate\Support\Facades\Http;
+use Tests\TestCase;
+
+/**
+ * The first-run flow: default login → new password → connect ERPNext
+ * (verified, not just pinged) → choose profiles (users imported) → normal flow.
+ * Uses the real DatabaseSeeder: bootstrap admin only, zero demo data.
+ */
+class SetupFlowTest extends TestCase
+{
+    use RefreshDatabase;
+
+    protected function setUp(): void
+    {
+        parent::setUp();
+        $this->seed();
+    }
+
+    protected function defaultCreds(): array
+    {
+        return [
+            'email' => config('forkpos.bootstrap_admin.email'),
+            'password' => config('forkpos.bootstrap_admin.password'),
+        ];
+    }
+
+    protected function vanDoc(): array
+    {
+        return [
+            'name' => 'Test Van POS',
+            'company' => 'ACME',
+            'currency' => 'MMK',
+            'warehouse' => 'Stores - M',
+            'selling_price_list' => 'Retail',
+            'allow_user_to_edit_rate' => 1,
+            'customer' => 'Walk-in Customer',
+            'applicable_for_users' => [['user' => 'cashier@erp.test', 'default' => 1]],
+            'item_groups' => [['item_group' => 'Drinks']],
+            'payments' => [['mode_of_payment' => 'Cash', 'default' => 1]],
+        ];
+    }
+
+    protected function fakeErp(): void
+    {
+        Http::fake([
+            'erp.example.test/api/method/frappe.auth.get_logged_user' => Http::response(['message' => 'api@erp.test'], 200),
+            'erp.example.test/api/resource/POS%20Profile/Test%20Van%20POS' => Http::response(['data' => $this->vanDoc()], 200),
+            'erp.example.test/api/resource/POS%20Profile*' => Http::response(['data' => [
+                ['name' => 'Test Van POS', 'company' => 'ACME', 'currency' => 'MMK', 'warehouse' => 'Stores - M'],
+            ]], 200),
+        ]);
+    }
+
+    public function test_fresh_install_has_only_the_bootstrap_admin_and_no_demo_data(): void
+    {
+        $this->assertSame(1, User::count());
+        $this->assertTrue(User::first()->must_change_password);
+        $this->assertSame(0, PosProfile::count());
+        $this->assertSame(0, Item::count());
+    }
+
+    public function test_default_login_walks_through_password_connect_and_profile_steps(): void
+    {
+        $this->fakeErp();
+
+        $this->post('/login', $this->defaultCreds())->assertRedirect('/');
+
+        // 1. must replace the bootstrap password
+        $this->get('/')->assertRedirect('/setup/password');
+        $this->post('/setup/password', [
+            'current_password' => $this->defaultCreds()['password'],
+            'password' => 'NewSecret123',
+            'password_confirmation' => 'NewSecret123',
+        ])->assertRedirect('/');
+        $this->assertFalse(User::first()->must_change_password);
+
+        // 2. connect ERPNext — credentials are verified, then stored
+        $this->get('/')->assertRedirect('/setup/connect');
+        $this->post('/setup/connect', [
+            'erpnext_url' => 'https://erp.example.test',
+            'erpnext_api_key' => 'k',
+            'erpnext_api_secret' => 's',
+        ])->assertRedirect('/setup/profiles');
+        Setting::flushCache();
+        $this->assertNotNull(Setting::current()->erpnext_verified_at);
+        $this->get('/')->assertRedirect('/setup/profiles');
+
+        // 3. choose profiles
+        $this->get('/setup/profiles')->assertOk()->assertSee('Test Van POS');
+        $this->post('/setup/profiles', ['profiles' => ['Test Van POS']])->assertRedirect('/');
+
+        $profile = PosProfile::where('erpnext_id', 'Test Van POS')->firstOrFail();
+        $this->assertSame('MMK', $profile->currency);
+        $this->assertTrue($profile->allow_rate_change);          // from the ERPNext doc
+        $this->assertFalse($profile->ask_for_customer);          // default customer present
+        $this->assertSame(['Drinks'], $profile->itemGroups());
+
+        // Cashier imported from "Applicable for Users": exists, attached, no PIN yet.
+        $cashier = User::where('email', 'cashier@erp.test')->firstOrFail();
+        $this->assertNull($cashier->pos_pin);
+        $this->assertTrue($profile->users()->where('users.id', $cashier->id)->exists());
+
+        // Setup is complete: the picker shows the profile.
+        $this->get('/')->assertOk()->assertSee('Test Van POS');
+    }
+
+    public function test_wrong_api_credentials_are_rejected_and_not_saved(): void
+    {
+        Http::fake([
+            'erp.example.test/api/method/frappe.auth.get_logged_user' => Http::response([], 401),
+        ]);
+        $admin = User::first();
+        $admin->forceFill(['must_change_password' => false])->save();
+
+        $this->actingAs($admin)->post('/setup/connect', [
+            'erpnext_url' => 'https://erp.example.test',
+            'erpnext_api_key' => 'bad',
+            'erpnext_api_secret' => 'bad',
+        ])->assertSessionHas('error');
+
+        Setting::flushCache();
+        $this->assertNull(Setting::current()->erpnext_verified_at);
+        $this->assertNull(Setting::current()->erpnext_url);
+    }
+
+    public function test_cashier_waits_when_setup_is_unfinished(): void
+    {
+        $cashier = User::create([
+            'name' => 'C', 'email' => 'c@x.test', 'password' => 'secret123',
+            'role' => User::ROLE_CASHIER, 'is_active' => true,
+        ]);
+
+        $this->actingAs($cashier)->get('/')->assertRedirect('/setup/waiting');
+        $this->actingAs($cashier)->get('/setup/connect')->assertForbidden();
+    }
+
+    public function test_profile_visibility_follows_erpnext_applicable_users(): void
+    {
+        $cashier = User::create(['name' => 'C', 'email' => 'c@x.test', 'password' => 'secret123', 'role' => 'cashier', 'is_active' => true]);
+        $other = User::create(['name' => 'O', 'email' => 'o@x.test', 'password' => 'secret123', 'role' => 'cashier', 'is_active' => true]);
+
+        $restricted = PosProfile::create(['name' => 'Restricted']);
+        $restricted->users()->sync([$other->id]);
+        PosProfile::create(['name' => 'Open to all']);
+        PosProfile::create(['name' => 'Off', 'device_enabled' => false]);
+
+        $this->assertSame(['Open to all'], PosProfile::visibleTo($cashier)->pluck('name')->all());
+        $this->assertEqualsCanonicalizing(['Open to all', 'Restricted'], PosProfile::visibleTo(User::first())->pluck('name')->all());
+    }
+
+    public function test_login_is_throttled(): void
+    {
+        for ($i = 0; $i < 5; $i++) {
+            $this->post('/login', ['email' => 'nobody@x.test', 'password' => 'wrong']);
+        }
+
+        $this->post('/login', ['email' => 'nobody@x.test', 'password' => 'wrong'])->assertStatus(429);
+    }
+
+    public function test_an_ambiguous_pin_never_logs_anyone_in(): void
+    {
+        foreach (['a@x.test', 'b@x.test'] as $email) {
+            User::create(['name' => $email, 'email' => $email, 'password' => 'secret123', 'role' => 'cashier', 'is_active' => true, 'pos_pin' => '4321']);
+        }
+
+        $this->from('/login')->post('/login', ['pin' => '4321'])->assertSessionHasErrors('pin');
+        $this->assertGuest();
+    }
+}
